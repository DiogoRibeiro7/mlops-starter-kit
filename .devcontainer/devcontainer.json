{
  "name": "MLOps Starter Kit",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "postCreateCommand": "python -m pip install poetry==2.2.1 && poetry sync && poetry run pre-commit install",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.black-formatter", "ms-python.vscode-pylance"],
      "settings": {
        "editor.formatOnSave": true,
        "[python]": {"editor.defaultFormatter": "ms-python.black-formatter"}
      }
    }
  }
}
